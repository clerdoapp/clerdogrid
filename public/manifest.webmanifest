{
  "name": "Clerdo Grid",
  "short_name": "Grid",
  "description": "Free spreadsheet app by Clerdo",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eceef3",
  "theme_color": "#0d3b2a",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"], "text/csv": [".csv"] } }
  ]
}
